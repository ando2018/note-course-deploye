{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "npm run build --prefix ../frontend",
    "dev": "concurrently -n API,WEB -c blue.bold,green.bold \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon --exec \"node --env-file-if-exists=.env\" server.js",
    "dev:web": "npm run watch --prefix ../frontend",
    "migrate:mongo": "node --env-file-if-exists=.env scripts/migrate-firestore-to-mongo.js",
    "reset:mongo": "node --env-file-if-exists=.env scripts/reset-mongo.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
