# Copier ce fichier en .env (ignoré par git) et adapter les valeurs.

# MongoDB local : mongodb://localhost:27017
# MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=note-course

# À définir en production. Changer cette valeur invalide toutes les sessions
# déjà ouvertes (les utilisateurs doivent se reconnecter).
# JWT_SECRET=
PORT=3001
